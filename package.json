{
  "name": "yolnoma-app",
  "private": true,
  "version": "v1.0.23",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "td": "tauri dev",
    "tb": "tauri build",
    "pretd": "node scripts/ensure-steam-utility-built.js",
    "pretb": "node scripts/ensure-steam-utility-built.js",
    "build:libs": "node scripts/build-steam-utility.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check package.json eslint.config.js scripts/build-steam-utility.js scripts/ensure-steam-utility-built.js src/app/App.tsx src/app/components/DevPreviewPanel.tsx src/shared/stores/updaterStore.ts src/shared/ui/UpdateModal.tsx",
    "validate:video-csp": "node scripts/validate-video-csp.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run build && npm run test && npm run validate:video-csp",
    "prepare": "husky"
  },
  "dependencies": {
    "@formspree/react": "^3.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "@tauri-apps/plugin-window-state": "^2",
    "@types/three": "^0.185.4",
    "@yolnoma/plugin-sdk": "^0.1.11",
    "bcryptjs": "^3.0.3",
    "highlight.js": "^11.12.0",
    "lightgallery": "^2.9.0",
    "lucide-react": "^1.30.0",
    "marked": "^18.0.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.2",
    "prettier": "^3.9.6",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{js,ts,tsx,json,css,md}": "prettier --write",
    "*.{ts,tsx}": "eslint --fix"
  }
}
